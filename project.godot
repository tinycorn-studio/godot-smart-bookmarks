; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited by hand.

config_version=5

[application]

config/name="Smart Bookmarks & Quick File Switcher"
run/main_scene="res://demo/demo.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[editor_plugins]

enabled=PackedStringArray("res://addons/smart_bookmarks/plugin.cfg")
